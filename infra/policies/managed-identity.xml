<!--
  API-level policy: APIM's managed identity authenticates to the backend (Foundry / Azure OpenAI).
  Grant the identity the "Cognitive Services OpenAI User" role on the backend resource.
  The inbound extras (token limit, token metric, circuit breaker backend) and the forward block (with
  retry) are inserted by infra/api.bicep where the double-underscore markers are.
-->
<policies>
  <inbound>
    <!-- do not forward the gateway subscription key or client bearer token to the backend -->
    <set-header name="api-key" exists-action="delete" />
    <set-header name="Authorization" exists-action="delete" />
    <authentication-managed-identity resource="https://cognitiveservices.azure.com" />
    __INBOUND_EXTRAS__
  </inbound>
  <backend>
    __FORWARD__
  </backend>
  <outbound />
  <on-error />
</policies>
