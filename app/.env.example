# Copy to .env (git-ignored) and fill in.
# Gateway base URL: https://<apim>.azure-api.net/foundry/v1
GATEWAY_BASE_URL=https://<apim>.azure-api.net/foundry/v1
GATEWAY_MODEL=gpt-6-sol

# Key mode (gateway authMode=subscriptionKey, the default)
GATEWAY_AUTH=key
# APIM subscription key (foundry-default, or foundry-<app> if you set the apps parameter)
GATEWAY_API_KEY=<apim subscription key>

# Entra mode (gateway authMode=entra): install with "uv sync --extra entra".
# Use a managed identity in Azure, or set AZURE_TENANT_ID, AZURE_CLIENT_ID and AZURE_CLIENT_SECRET elsewhere.
# GATEWAY_AUTH=entra
# GATEWAY_ENTRA_SCOPE=api://<gateway-client-id>/.default
