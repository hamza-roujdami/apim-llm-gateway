# Copy to .env (git-ignored) and fill in.
# Foundry API:  https://<apim>.azure-api.net/foundry/v1
# Compass API:  https://<apim>.azure-api.net/compass/v1
GATEWAY_BASE_URL=https://<apim>.azure-api.net/foundry/v1
# APIM subscription key of that API (foundry-default or compass-default)
GATEWAY_API_KEY=<apim subscription key>
GATEWAY_MODEL=gpt-6-sol
